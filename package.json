{
  "name": "dnd-ai-game",
  "version": "1.0.0",
  "description": "Multiplayer D&D Game with AI Dungeon Master, 3D Animated D20, and Customizable Profiles",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"node server/index.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client install && npm --prefix client run build",
    "postinstall": "npm --prefix client install && npm --prefix client run build",
    "install-all": "npm install && npm --prefix client install"
  },
  "keywords": ["dnd", "ai-dm", "multiplayer", "socket.io", "react", "3d-dice"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
